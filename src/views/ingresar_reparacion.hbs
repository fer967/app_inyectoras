<h1>Ingresar Reparación</h1>

<form action="/consultar/ingresar-reparacion/{{tarea.id}}" method="post">
    <input type="hidden" name="tarea_id" value="{{tarea.id}}">
    <input type="hidden" name="inyectora_id" value="{{inyectora.id}}">
    <input type="hidden" name="tecnico_id" value="{{tarea.tecnico.id}}">
    <div class="form-group">
        <label>Marca:</label>
        <input type="text" class="form-control" value="{{inyectora.marca}}" disabled>
    </div>
    <div class="form-group">
        <label>Modelo:</label>
        <input type="text" class="form-control" value="{{inyectora.modelo}}" disabled>
    </div>
    <div class="form-group">
        <label>Falla reportada:</label>
        <textarea class="form-control" rows="3" disabled>{{tarea.descripcion}}</textarea>
    </div>
    <div class="form-group">
        <label>Sistema:</label>
        <input type="text" class="form-control" value="{{tarea.sistema}}" disabled>
    </div>
    <div class="form-group">
        <label>Reparación Realizada:</label>
        <textarea class="form-control" id="reparacion_realizada" name="reparacion_realizada" rows="3" required></textarea>
    </div>
    <div class="form-group">
        <label>Técnico:</label>
        <input type="text" class="form-control" value="{{tarea.tecnico.nombre}} {{tarea.tecnico.apellido}}" disabled>
    </div>
    <div class="form-group">
        <label>Fecha:</label>
        <input type="text" class="form-control" value="{{formatDate tarea.created_at "DD/MM/YYYY"}}" disabled>
    </div>
    <button type="submit" class="btn btn-primary">Guardar Reparación</button>
</form>
<br>
<a href="/consultar" class="btn btn-success">Inicio</a>
