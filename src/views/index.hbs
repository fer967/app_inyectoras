<h1>App de Mantenimiento</h1>
<br>
<h3>Consultas</h3>
<br>
<form action="/consultar/mostrar-reparaciones" method="post">
    <button type="submit" class="btn btn-primary">Mostrar reparaciones realizadas</button>
</form>
<br><br>
<h3>Búsqueda en Base de Datos</h3>
<form action="/consultar/consultar-bot" method="post">
    <div class="form-group">
        <label for="pregunta_bd">Marca, Modelo y Sistema</label>
        <input type="text" class="form-control" id="pregunta_bd" name="pregunta_bd"
            placeholder="Ej: Arburg 270 S hidráulico">
    </div>
    <button type="submit" class="btn btn-info">Buscar en BD</button>
</form>
<br><br>
<h3>Consultar Falla (IA)</h3>
<form action="/consultar/consultar-bot" method="post">
    <div class="form-group">
        <label for="pregunta_ia">Describa la falla</label>
        <input type="text" class="form-control" id="pregunta_ia" name="pregunta_ia"
            placeholder="Ej: poca presión hidráulica, se traba el husillo...">
    </div>
    <button type="submit" class="btn btn-warning">Consultar IA</button>
</form>
<br><br>
<a href="/consultar/ingresar-reparacion">Ingresar Nueva Reparación</a>
<br>
<a href="/auth/logout">cerrar sesion</a>





