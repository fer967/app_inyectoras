<h1>Listado de Tareas</h1>

<a href="/consultar/tareas/crear" class="btn btn-primary mb-3">➕ Crear Nueva Tarea</a>

<table class="table table-striped table-bordered">
    <thead class="table-dark">
        <tr>
            <th>Título</th>
            <th>Descripción</th>
            <th>Estado</th>
            <th>Prioridad</th>
            <th>Técnico Asignado</th>
            <th>Fecha Límite</th>
            <th>Creada</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        {{#each tareas}}
        <tr>
            <td>{{titulo}}</td>
            <td>{{descripcion}}</td>
            <td>
                {{#if (eq estado "pendiente")}}
                    <span class="badge bg-secondary">{{estado}}</span>
                {{/if}}
                {{#if (eq estado "en_progreso")}}
                    <span class="badge bg-warning text-dark">{{estado}}</span>
                {{/if}}
                {{#if (eq estado "completada")}}
                    <span class="badge bg-success">{{estado}}</span>
                {{/if}}
            </td>
            <td>{{prioridad}}</td>
            <td>
                {{#if tecnico}}
                    {{tecnico.nombre}} {{tecnico.apellido}}
                {{else}}
                    <span class="text-muted">Sin asignar</span>
                {{/if}}
            </td>
            <td>
                {{#if fecha_limite}}
                    {{formatDate fecha_limite "DD/MM/YYYY"}}
                {{else}}
                    -
                {{/if}}
            </td>
            <td>{{formatDate created_at "DD/MM/YYYY HH:mm"}}</td>
            <td>
                <a href="/consultar/tareas/{{id}}" class="btn btn-info btn-sm">
                    Ver Detalle
                </a>
            </td>
        </tr>
        {{/each}}
    </tbody>
</table>
<a href="/consultar" class="btn btn-secondary mt-3">Inicio</a>
